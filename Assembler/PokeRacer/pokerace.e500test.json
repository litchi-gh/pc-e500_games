{
  // ポケレーサーのテスト。字は自分のフォントで描くので、画面ではなくメモリの値で確かめる。
  // 速さ speed は × 1.25 が km/h。nt = 前のコマにかかった 16 ミリ秒の回数、stp = このコマに進む量。
  // 得点 score は BCD 4 バイト（上の桁が先）。
  "program": "pokerace.asm",
  "tests": [
    { "name": "タイトル", "basic": "CALL &HB9400", "maxCycles": 1500000,
      "expect": { "state": "running", "memory": { "demo": [0] } } },
    { "name": "SPACE で車を選ぶ画面（初めは GT-500）", "basic": "CALL &HB9400", "keys": ["SPACE"], "maxCycles": 1500000,
      "expect": { "memory": { "(sel)": [1] } } },
    { "name": "▶ で次の車", "basic": "CALL &HB9400", "keys": ["SPACE", "RIGHT"], "maxCycles": 1500000,
      "expect": { "memory": { "(sel)": [2] } } },
    { "name": "6 でも次の車", "basic": "CALL &HB9400", "keys": ["SPACE", "6"], "maxCycles": 1500000,
      "expect": { "memory": { "(sel)": [2] } } },
    { "name": "4 で前の車", "basic": "CALL &HB9400", "keys": ["SPACE", "4"], "maxCycles": 1500000,
      "expect": { "memory": { "(sel)": [0] } } },
    { "name": "車を決めてステージ 1 へ", "basic": "CALL &HB9400", "keys": ["SPACE", "SPACE", "wait:3"], "maxCycles": 1500000,
      "expect": { "memory": { "stage": [0], "car": [1], "c_top": [192], "st_time": [32], "st_secs": [3], "st_cbase": [48] } } },
    { "name": "時間切れで GAME OVER（ステージ 1 の時間を 3 秒にして）", "basic": "CALL &HB9400", "keys": ["SPACE", "SPACE", "wait:10"],
      "memory": { "stage_tab+17": [3] }, "maxCycles": 1500000,
      "expect": { "memory": { "race_state": [2], "time": [0] } } },
    { "name": "ON/BRK で戻る", "basic": "CALL &HB9400", "keys": ["SPACE", "SPACE", "wait:6", "ON/BRK"], "maxCycles": 1500000,
      "expect": { "screen": ">" } },

    { "name": "コースの図に点を打つ（x 5、y 10 → 2 行目のビット 2）", "call": "map_plot", "return": "near", "registers": { "A": 10 },
      "memory": { "($EC)": [0], "(tch)": [5], "map_buf+45": [1] },
      "expect": { "memory": { "map_buf+45": [5] } } },
    { "name": "進み具合の段 = DIST ÷ 1 段の DIST（37 まで）", "call": "bar_pos", "return": "near",
      "memory": { "($EC)": [0], "odo": [0, 100, 0], "bar_unit": [30, 0] },
      "expect": { "registers": { "A": 3 } } },
    { "name": "符号付きで広げる", "call": "sext", "return": "near", "registers": { "A": 196 },
      "expect": { "registers": { "BA": 65476 } } },
    { "name": "進む量: 240 km/h、3 回 → 60 × 3", "call": "calc_step", "return": "near",
      "memory": { "speed": [192], "nt": [3] }, "expect": { "memory": { "stp": [180, 0] } } },
    { "name": "進む量: 315 km/h（256 を越える）", "call": "calc_step", "return": "near",
      "memory": { "speed": [252], "nt": [3] }, "expect": { "memory": { "stp": [234, 0] } } },
    { "name": "スタートの数字が変わる", "call": "countdown", "return": "near",
      "memory": { "cdown": [63], "nt": [3], "cd_last": [2] },
      "expect": { "memory": { "cdown": [60], "cd_last": [1], "cd_str": "1" } } },
    { "name": "GO! で走り出す", "call": "countdown", "return": "near",
      "memory": { "cdown": [2], "nt": [3], "cd_last": [1], "msg": [0] },
      "expect": { "memory": { "cdown": [0], "cd_last": [0], "msg": [40], "msg_big": [1] } } },
    { "name": "得点を足す（BCD）", "call": "add_score", "return": "near", "registers": { "BA": 1280 },
      "memory": { "score": [0, 0, 18, 52] }, "expect": { "memory": { "score": [0, 0, 23, 52], "score_dirty": [1] } } },
    { "name": "得点の桁上がり", "call": "add_score", "return": "near", "registers": { "BA": 256 },
      "memory": { "score": [0, 0, 153, 80] }, "expect": { "memory": { "score": [0, 1, 0, 80] } } },
    { "name": "追い越すと PASS が増え、100 点", "call": "cars_move", "return": "near",
      "memory": { "nt": [3], "stp": [180, 0], "plat": [0, 0], "crash": [0], "passes": [0], "demo": [0], "score": [0, 0, 0, 0],
                  "rivals": [184, 11, 0, 0, 45, 0,  40, 0, 224, 1, 45, 1] },
      // 速さ 45（180 km/h）の車は 135、自分は 180 進む: 3000、40（横 480）→ 2955、-5
      "expect": { "memory": { "passes": [1], "crash": [0], "score": [0, 0, 1, 0],
                              "rivals": [139, 11, 0, 0, 45, 0,  251, 255, 224, 1, 45, 1] } } },
    { "name": "前の車に当たると遅くなる", "call": "cars_move", "return": "near",
      "memory": { "nt": [3], "stp": [180, 0], "speed": [200], "plat": [0, 0], "crash": [0], "passes": [0], "turbo": [50],
                  "rivals": [184, 11, 0, 0, 45, 0,  144, 1, 0, 0, 45, 0] },
      // 400 の車が 355 に近づいて当たる: 速さ 1/4、ターボは消える、相手は 500 前へ（855）
      "expect": { "memory": { "speed": [50], "crash": [30], "turbo": [0], "passes": [0],
                              "rivals": [139, 11, 0, 0, 45, 0,  87, 3, 0, 0, 45, 0] } } },
    { "name": "チェックポイント: 時間 + st_bonus、1000 点", "call": "advance", "return": "near",
      "memory": { "stp": [0, 0], "nt": [3], "demo": [0], "race_state": [0], "time": [10], "tfrac": [0], "section": [0],
                  "st_secs": [3], "st_bonus": [35], "st_cpd": [124, 1], "odo": [0, 124, 1], "dist_last": [124],
                  "next_cp": [124, 1], "seg_rem": [100, 0], "score": [0, 0, 0, 0] },
      "expect": { "memory": { "time": [45], "section": [1], "next_cp": [248, 2], "score": [0, 0, 16, 0], "race_state": [0] } } },
    { "name": "最後の区間を走り切るとゴール", "call": "advance", "return": "near",
      "memory": { "stp": [0, 0], "nt": [3], "demo": [0], "race_state": [0], "time": [10], "section": [2],
                  "st_secs": [3], "odo": [0, 100, 0], "dist_last": [100], "next_cp": [100, 0], "seg_rem": [100, 0] },
      "expect": { "memory": { "race_state": [1], "goal_t": [70], "section": [3], "msg_big": [1] } } },
    { "name": "時間切れ", "call": "advance", "return": "near",
      "memory": { "stp": [0, 0], "nt": [3], "demo": [0], "race_state": [0], "time": [1], "tfrac": [61],
                  "odo": [0, 0, 0], "dist_last": [0], "next_cp": [100, 0], "seg_rem": [100, 0] },
      "expect": { "memory": { "time": [0], "race_state": [2] } } },
    { "name": "ターボを取る", "call": "item_take", "return": "near", "registers": { "A": 0 },
      "memory": { "turbo": [0] }, "expect": { "memory": { "turbo": [190] } } },
    { "name": "時計を取ると +5 秒（99 まで）", "call": "item_take", "return": "near", "registers": { "A": 1 },
      "memory": { "time": [97] }, "expect": { "memory": { "time": [99] } } },
    { "name": "コインを取ると 500 点", "call": "item_take", "return": "near", "registers": { "A": 2 },
      "memory": { "score": [0, 0, 0, 0] }, "expect": { "memory": { "score": [0, 0, 5, 0] } } },
    { "name": "オイルで回って 3/4 に", "call": "item_take", "return": "near", "registers": { "A": 3 },
      "memory": { "speed": [200], "crash": [0] }, "expect": { "memory": { "speed": [150], "crash": [20] } } },
    { "name": "加速（車の加速 12、3 回 → 4.5）", "call": "control", "return": "near",
      "memory": { "(pad_now)": [0], "nt": [3], "speed": [100], "spdf": [0], "crash": [0], "turbo": [0], "offroad": [0],
                  "plat": [0, 0], "c_top": [192], "c_acc": [12], "c_steer": [7], "c_grip": [2] },
      "expect": { "memory": { "speed": [104], "spdf": [4], "brake": [0] } } },
    { "name": "ブレーキ: 1 回に 3", "call": "control", "return": "near",
      "memory": { "(pad_now)": [8], "nt": [3], "speed": [100], "crash": [0], "turbo": [0], "offroad": [0],
                  "plat": [0, 0], "c_top": [192], "c_acc": [12], "c_steer": [7], "c_grip": [2] },
      "expect": { "memory": { "speed": [91], "brake": [1] } } },
    { "name": "SPACE でもブレーキ", "call": "control", "return": "near",
      "memory": { "(pad_now)": [16], "nt": [3], "speed": [100], "crash": [0], "turbo": [0], "offroad": [0],
                  "plat": [0, 0], "c_top": [192], "c_acc": [12], "c_steer": [7], "c_grip": [2] },
      "expect": { "memory": { "speed": [91], "brake": [1] } } },
    { "name": "ターボが終わると最高速度まで落ちていく", "call": "control", "return": "near",
      "memory": { "(pad_now)": [0], "nt": [3], "speed": [230], "crash": [0], "turbo": [0], "offroad": [0],
                  "plat": [0, 0], "c_top": [192], "c_acc": [12], "c_steer": [7], "c_grip": [2] },
      "expect": { "memory": { "speed": [227] } } },
    { "name": "ハンドル（左）: 1 回に 速さ/32 + 7", "call": "control", "return": "near",
      "memory": { "(pad_now)": [1], "nt": [2], "speed": [64], "crash": [30], "turbo": [0], "offroad": [0],
                  "plat": [0, 0], "c_top": [192], "c_acc": [12], "c_steer": [7], "c_grip": [2] },
      // 当たった直後なので加速しない。(2 + 7) × 2 = 18
      "expect": { "memory": { "speed": [64], "steer": [1], "plat": [238, 255], "crash": [29] } } }
  ]
}
